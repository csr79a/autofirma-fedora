#!/usr/bin/env bash
set -euo pipefail

SELF="$(readlink -f -- "$0" 2>/dev/null || realpath -- "$0" 2>/dev/null || printf '%s' "$0")"
GUI_DIR="$(cd -- "$(dirname -- "$SELF")" && pwd)"
GUI="$GUI_DIR/autofirma_fedora_gui.py"

if [[ ! -f "$GUI" ]]; then
    printf '[ERROR] No se encuentra la GUI: %s\n' "$GUI" >&2
    exit 1
fi

exec /usr/bin/python3 "$GUI" "$@"
